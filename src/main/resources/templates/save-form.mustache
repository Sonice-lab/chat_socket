<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>메세지 작성</title>
    <style>
        body {
            margin: 20px;
            font-family: Arial, sans-serif
        }

        nav a {
            padding: 8px 15px;
            margin-right: 10px;
            background: #666;
            color: white;
            text-decoration: none
        }

        form {margin-top: 20px}
        input {padding: 8px; width: 300px; margin-right: 10px}
        button {padding: 8px 15px; background: #007bff; color: white; border: none}

        .message {
            padding: 5px 10px;
            margin: 3px 0;
            background: white;
            border-radius: 8px;
            max-width: 80%;
        }
    </style>
</head>
<body>
<nav>
    <a href="">목록</a>
    <a href="/save-form">작성</a>
</nav>

<h3>메세지 작성</h3>
<form action="/chat" method="post">
    <input type="text" name="msg" , id="msg" placeholder="메세지 입력" required autofocus>
    <button type="submit">전송</button>
</form>


</body>
</html>