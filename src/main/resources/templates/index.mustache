<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>채팅 (STOMP)</title>
    <!--  STOMP 클라이언트 라이브러리  -->
    <script src="https://cdn.jsdelivr.net/npm/@stomp/stompjs@7.5.0/bundles/stomp.umd.min.js"></script>
    <style>
        body {
            margin: 20px;
            font-family: Arial, sans-serif
        }

        nav a {
            padding: 8px 15px;
            margin-right: 10px;
            background: #666;
            color: white;
            text-decoration: none
        }

        .info {
            color: #666;
            font-size: 13px;
        }

        .chat-area {
            border: 1px solid #ccc;
            height: 300px;
            padding: 10px;
            overflow-y: scroll;
            background: #f9f9f9;
        }

        .message {
            padding: 5px 10px;
            margin: 3px 0;
            background: white;
            border-radius: 8px;
            max-width: 80%;
        }

        form {
            margin-top: 10px;
            display: flex;
            gap: 10px;
        }

        input {
            flex: 1;
            padding: 8px;
        }

        button {
            padding: 8px 15px;
            background: #007bff;
            color: white;
            border: none
        }
    </style>
</head>
<body>
<nav>
    <a href="/rooms/1">1번방</a>
    <a href="/rooms/2">2번방</a>
    <a href="/rooms/3">3번방</a>
</nav>
<h3>채팅 (STOMP)</h3>
<p id="status">서버에 연결하는 중...</p>

<div class="chat-area" id="chatArea">
    {{#chats}}
        <div class="message">{{msg}}</div>
    {{/chats}}
</div>

<form id="chatForm">
    <input type="text" name="sender" , id="sender" placeholder="이름" value="익명" required autofocus>
    <input type="text" name="msg" , id="msg" placeholder="메세지 입력" required autofocus>
    <button type="submit">전송</button>
</form>

<script>
    // 서버가 그려준 현재 방 번호
    const roomId = `{{roomId}}`;

    // 돔에 접근할 준비물 준비 완료
    const chatArea = document.getElementById('chatArea');
    const status = document.getElementById('status');
    const chatForm = document.getElementById('chatForm');
    const msgInput = document.getElementById('msg');

    // 받은 메시지를 화면 맨 아래에 추가한다.
    // 화면을 랜더링해주는 함수
    function appendMessage(sender, msg) {
        const div = document.createElement("div");
        div.className = "message";

        const nameSpan = document.createElement("span");
        nameSpan.className = 'name';
        nameSpan.textContent = sender;

        div.appendChild(nameSpan);
        div.appendChild(document.createTextNode(msg));  // 내용 붙이기

        chatArea.appendChild(div);
        chatArea.scrollTop = chatArea.scrollHeight;
    }

   // 1 .STOMP 클라이언트를 만든다.
    const protocol = location.protocol === 'https:' ? 'wss://' : 'ws://';
    const client = new StompJs.Client({
        brokerURL : protocol + location.host + "/ws-stomp",
        reconnectionDelay: 5000 // 연결이 끊어졌을 경우 5초마다 다시 연결
    });

    // 2. 연결이 되면 이 방의 주소를 구독한다.
    client.onConnect = () => {
        status.textContent = "서버와 연결됨(STOMP): " + roomId + "번 방";

        client.subscribe('/sub/chat/' + roomId, (message) => {
           // message.body는 JSON 형식의 문자열로 들어온다.
           const dto = JSON.parse(message.body);
           appendMessage(dto.sender, dto.msg);

        });
    }

    // 3. 연결이 끊기면 알아서 다시 연결을 시도한다.
    client.onWebSocketClose = () => {
        alert("연결 중단! 재연결 시도중...")
    }

    // 4. 서버가 ERROR 프레임을 보내면 콘솔에 남긴다.
    client.onStompError = (frame) => {
        console.log("STOMP 오류: ", frame.headers['message']);
    }

    // 5. 전송: JSON으로 변경해서 /pub/chat/방번호로 던진다.
    chatForm.addEventListener("submit", (e) => {
       e.preventDefault();

       const msg = msgInput.value.trim();
       if(msg === '') return;

       if(!client.connected) {
           alert("서버와 연결되어있지 않습니다.");
           return;
       }
        // 객체 만듬
       const dto = {sender: document.getElementById("sender").value,
           msg: msg}

       client.publish({destination: '/pub/chat/' + roomId,
           body: JSON.stringify(dto)});

       msgInput.value = '';
       msgInput.focus();

    });

    // 연결 시작
    client.activate();

    // 처음 그려진 메세지 중 최신 메시지가 보이도록 스크롤을 맨 아래로 내린다.
    chatArea.scrollTop = chatArea.scrollHeight;

</script>

</body>
</html>