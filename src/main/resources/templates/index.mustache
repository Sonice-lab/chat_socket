<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>채팅 (폴링)</title>
    <style>
        body {
            margin: 20px;
            font-family: Arial, sans-serif
        }

        nav a {
            padding: 8px 15px;
            margin-right: 10px;
            background: #666;
            color: white;
            text-decoration: none
        }

        .info {
            color: #666;
            font-size: 13px;
        }

        .chat-area {
            border: 1px solid #ccc;
            height: 300px;
            padding: 10px;
            overflow-y: scroll;
            background: #f9f9f9;
        }

        .message {
            padding: 5px 10px;
            margin: 3px 0;
            background: white;
            border-radius: 8px;
            max-width: 80%;
        }

        form {
            margin-top: 10px;
            display: flex;
            gap: 10px;
        }

        input {
            flex: 1;
            padding: 8px;
        }

        button {
            padding: 8px 15px;
            background: #007bff;
            color: white;
            border: none
        }
    </style>
</head>
<body>

<h3>채팅 (WebSocket)</h3>
<p id="status">서버에 연결하는 중...</p>

<div class="chat-area" id="chatArea">
    {{#chats}}
        <div class="message">{{msg}}</div>
    {{/chats}}
</div>

<form id="chatForm">
    <input type="text" name="msg" , id="msg" placeholder="메세지 입력" required autofocus>
    <button type="submit">전송</button>
</form>

<script>
    // 돔에 접근할 준비물 준비 완료
    const chatArea = document.getElementById('chatArea');
    const status = document.getElementById('status');
    const chatForm = document.getElementById('chatForm');
    const msgInput = document.getElementById('msg');

    // 받은 메시지를 화면 맨 아래에 추가한다.
    // 화면을 랜더링해주는 함수
    function appendMessage(msg) {
        const div = document.createElement("div");
        div.className = "message";
        div.textContent = msg; // 내용 붙여넣기
        chatArea.appendChild(div);
        chatArea.scrollTop = chatArea.scrollHeight;
    }

    // ===== 웹 소켓 연결 =====
    // 메시지 규칙 접두사 만들기 서버(ChatWebSocketHandler)와 똑같이 맞춰야 한다.
    const PREFIX_CHAT = 'CHAT:';
    const PREFIX_MESSAGE = 'MESSAGE:';
    const PREFIX_ERROR = 'ERROR:';

    // 1. 서버에 WebSocket 연결을 연다. (브라우저 내장 객체)
    // tip: 페이지가 http 면 ws://, https 면 wss:// 로 연결한다.
    const protocol = location.protocol === 'https:' ? 'wss://' : 'ws://';
    const socket = new WebSocket(protocol + location.host + '/ws-chat');
    // todo - 삭제 예정
    console.log("주소 확인: ", protocol + location.host + '/ws-chat')


    // 2. 응답 받는 부분에 대한 처리
    // 연결이 열리면 (101) 확인
    socket.onopen = () => {
        status.textContent = '서버와 연결됨 (WebSocket)';
    }

    // 3. 서버가 메시지를 보내면 접두사를 확인하고 나눈다.
    // 프레임 단위로 들어온다는 것은 무슨 의미?
    socket.onmessage = (event) => {
        const text = event.data;
        if (text.startsWith(PREFIX_MESSAGE)) {
            appendMessage(text.substring(PREFIX_MESSAGE.length));
        } else if(text.startsWith(PREFIX_ERROR)) {
            alert(text.substring(PREFIX_ERROR.length));
        } else {
            console.log("규칙이 없는 메시지: ", text);
        }
    }

    // 4. 연결이 닫히면 내용을 수정한다.(확인용)
    socket.onclose = (event) => {
        status.textContent = "연결이 끊겼습니다. 재연결을 위해 새로고침해주세요.";
    }

    // 5. 프레임 단위로 주고 받아야하므로 그에 대한 처리
    // 전송
    chatForm.addEventListener('submit', (e) => {
       // 기본 동작 새로고침 방어
        e.preventDefault();
       const msg = msgInput.value.trim();
       // 방어적 코드
        if(msg === '') return;

        // 주의
        // 연결이 열린 상태(OPEN)에서만 보낼 수 있다.
        // 연결중에 send()를 부르면 오류가 난다.
        if(socket.readyState !== WebSocket.OPEN) {
            alert("서버와 연결되어있지 않습니다.");
            return;
        }

        socket.send(PREFIX_CHAT + msg);
        msgInput.value = '';
        msgInput.focus();


    });


    // 처음 그려진 메세지 중 최신 메시지가 보이도록 스크롤을 맨 아래로 내린다.
    chatArea.scrollTop = chatArea.scrollHeight;

</script>

</body>
</html>